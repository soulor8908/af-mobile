{
  "$description": "AIFlow UI L1 设计 Token（W3C Design Tokens Format 1.1）。由 src/tokens.css 自动生成，勿手改，运行 `npm run tokens` 重新生成。palette 为 light 基准值，dark 值见 palette.$extensions.aiflow.theme.dark。阴影因源为 CSS 简写字符串，采用 string 类型保证 W3C 校验兼容。",
  "palette": {
    "brand": {
      "$type": "color",
      "$value": "#2563eb"
    },
    "onbrand": {
      "$type": "color",
      "$value": "#fff"
    },
    "text": {
      "$type": "color",
      "$value": "#1a2332"
    },
    "muted": {
      "$type": "color",
      "$value": "#5a6b7e"
    },
    "card": {
      "$type": "color",
      "$value": "#fff"
    },
    "bg": {
      "$type": "color",
      "$value": "#fafbfc"
    },
    "muted-bg": {
      "$type": "color",
      "$value": "#f1f4f8"
    },
    "border": {
      "$type": "color",
      "$value": "#dde3eb"
    },
    "danger": {
      "$type": "color",
      "$value": "#dc2626"
    },
    "success": {
      "$type": "color",
      "$value": "#16a34a"
    },
    "warn": {
      "$type": "color",
      "$value": "#d97706"
    },
    "shadow-sm": {
      "$type": "string",
      "$value": "0 1px 2px rgba(0,0,0,.05)"
    },
    "shadow-md": {
      "$type": "string",
      "$value": "0 4px 12px rgba(0,0,0,.08)"
    },
    "shadow-lg": {
      "$type": "string",
      "$value": "0 8px 24px rgba(0,0,0,.12)"
    },
    "color-scheme": {
      "$type": "other",
      "$value": "light"
    },
    "$extensions": {
      "aiflow": {
        "theme": {
          "dark": {
            "brand": "#3b82f6",
            "onbrand": "#fff",
            "text": "#e2e8f0",
            "muted": "#94a3b8",
            "card": "#1e293b",
            "bg": "#0f172a",
            "muted-bg": "#1e293b",
            "border": "#334155",
            "danger": "#ef4444",
            "success": "#22c55e",
            "warn": "#f59e0b",
            "shadow-sm": "0 1px 2px rgba(0,0,0,.3)",
            "shadow-md": "0 4px 12px rgba(0,0,0,.4)",
            "shadow-lg": "0 8px 24px rgba(0,0,0,.5)",
            "color-scheme": "dark"
          }
        }
      }
    }
  },
  "color": {
    "brand": {
      "$type": "color",
      "$value": "{palette.brand}"
    },
    "onbrand": {
      "$type": "color",
      "$value": "{palette.onbrand}"
    },
    "text": {
      "$type": "color",
      "$value": "{palette.text}"
    },
    "muted": {
      "$type": "color",
      "$value": "{palette.muted}"
    },
    "card": {
      "$type": "color",
      "$value": "{palette.card}"
    },
    "bg": {
      "$type": "color",
      "$value": "{palette.bg}"
    },
    "muted-bg": {
      "$type": "color",
      "$value": "{palette.muted-bg}"
    },
    "border": {
      "$type": "color",
      "$value": "{palette.border}"
    },
    "danger": {
      "$type": "color",
      "$value": "{palette.danger}"
    },
    "success": {
      "$type": "color",
      "$value": "{palette.success}"
    },
    "warn": {
      "$type": "color",
      "$value": "{palette.warn}"
    }
  },
  "spacing": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "typography": {
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "12px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "14px"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "18px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "22px"
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": 1.25
      },
      "normal": {
        "$type": "number",
        "$value": 1.7
      }
    },
    "weight": {
      "normal": {
        "$type": "number",
        "$value": 400
      },
      "medium": {
        "$type": "number",
        "$value": 500
      },
      "bold": {
        "$type": "number",
        "$value": 700
      }
    }
  },
  "radius": {
    "s": {
      "$type": "dimension",
      "$value": "4px"
    },
    "m": {
      "$type": "dimension",
      "$value": "8px"
    },
    "l": {
      "$type": "dimension",
      "$value": "12px"
    },
    "f": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "shadow": {
    "sm": {
      "$type": "string",
      "$value": "{palette.shadow-sm}"
    },
    "md": {
      "$type": "string",
      "$value": "{palette.shadow-md}"
    },
    "lg": {
      "$type": "string",
      "$value": "{palette.shadow-lg}"
    }
  },
  "zIndex": {
    "base": {
      "$type": "number",
      "$value": 0
    },
    "sticky": {
      "$type": "number",
      "$value": 200
    },
    "dropdown": {
      "$type": "number",
      "$value": 1000
    },
    "modal": {
      "$type": "number",
      "$value": 1100
    }
  },
  "motion": {
    "out": {
      "$type": "cubicBezier",
      "$value": {
        "x1": 0.16,
        "y1": 1,
        "x2": 0.3,
        "y2": 1
      }
    },
    "in-out": {
      "$type": "cubicBezier",
      "$value": {
        "x1": 0.65,
        "y1": 0,
        "x2": 0.35,
        "y2": 1
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "250ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms"
      }
    }
  }
}
