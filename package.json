{
  "name": "@af-mobile/ui",
  "version": "1.9.1",
  "description": "Mobile-first Web Components library with L1/L2/L3 layered design system",
  "workspaces": [
    ".",
    "eslint-plugin-af-mobile",
    "create-af-mobile",
    "mcp",
    "prompt",
    "adapters",
    "tokens"
  ],
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./k": {
      "import": "./src/k/index.js",
      "types": "./src/k/index.d.ts",
      "default": "./src/k/index.js"
    },
    "./charts": {
      "import": "./src/charts/index.js",
      "types": "./src/charts/index.d.ts",
      "default": "./src/charts/index.js"
    },
    "./chat": {
      "import": "./src/chat/index.js",
      "types": "./src/chat/index.d.ts",
      "default": "./src/chat/index.js"
    },
    "./blocks": {
      "import": "./src/blocks/index.js",
      "types": "./src/blocks/index.d.ts",
      "default": "./src/blocks/index.js"
    },
    "./blocks/*": "./src/blocks/*",
    "./test": "./src/test-setup.js",
    "./vite": "./src/vite.js",
    "./css": "./src/index.css",
    "./af-mobile.css": "./src/index.css",
    "./tokens.css": "./src/tokens.css",
    "./tokens.json": "./src/tokens.json",
    "./recipes.css": "./src/recipes.css",
    "./atomic.css": "./src/atomic.css",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*",
    "./dist": "./dist/index.js",
    "./dist/css": "./dist/index.css",
    "./dist/components.css": "./dist/components.css",
    "./dist/blocks": "./dist/blocks.js"
  },
  "bin": {
    "af-mobile": "./scripts/af-mobile.mjs"
  },
  "sideEffects": [
    "**/*.css",
    "src/chat/i18n.js",
    "src/test-setup.js"
  ],
  "files": [
    "src",
    "dist",
    "skills",
    "assets",
    "eval/telemetry.mjs",
    "scripts/skill-add.mjs",
    "scripts/create-app.mjs",
    "scripts/af-mobile.mjs",
    "scripts/lint-flywheel.mjs",
    "scripts/deploy.mjs",
    "scripts/ai-fix.mjs",
    "scripts/resolve-asset.mjs"
  ],
  "scripts": {
    "test": "node scripts/check-contrast.mjs && vitest run",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "perf": "node scripts/perf.mjs",
    "perf:check": "node scripts/perf.mjs --budget",
    "size": "node scripts/size-check.mjs",
    "size:check": "node scripts/size-check.mjs",
    "whitelist": "node scripts/gen-whitelist.mjs",
    "whitelist:check": "node scripts/check-whitelist-sync.mjs",
    "aria:check": "node scripts/check-aria-sync.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/check-tokens-sync.mjs",
    "fewshots:gen": "node scripts/gen-component-fewshots.mjs",
    "prompt:check": "node scripts/gen-component-fewshots.mjs --check && node scripts/check-prompt-sync.mjs",
    "demo:check": "node scripts/check-demo.mjs",
    "scaffold:check": "node scripts/check-scaffold.mjs",
    "skill:check": "node scripts/check-skill-exports.mjs",
    "types:check": "node scripts/check-types-sync.mjs",
    "entry": "node scripts/gen-entry.mjs",
    "entry:check": "node scripts/gen-entry.mjs --check",
    "prompt": "bash scripts/build-prompt.sh",
    "prompt:build": "node scripts/build-prompt.mjs -o prompt/system-prompt.md",
    "ai-fix": "node scripts/ai-fix.mjs",
    "lint:flywheel": "node scripts/lint-flywheel.mjs",
    "generate": "node scripts/generate.mjs",
    "skill:add": "node scripts/skill-add.mjs",
    "create": "node scripts/create-app.mjs",
    "pkg:assets": "node scripts/sync-pkg-assets.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:prompt": "node scripts/build-prompt-pkg.mjs",
    "pub:mcp": "npm run build:mcp && npm publish --workspace=@af-mobile/mcp",
    "pub:prompt": "npm run build:prompt && npm publish --workspace=@af-mobile/prompt",
    "pub:tokens": "node scripts/build-tokens-pkg.mjs && npm publish --workspace=@af-mobile/tokens",
    "mcp": "node mcp/index.mjs",
    "eval": "node eval/run.mjs",
    "eval:dry": "node eval/run.mjs --dry-run",
    "eval:flywheel": "node eval/flywheel.mjs",
    "publish:check": "node scripts/publish-check.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "changeset": "changeset",
    "changeset:check": "changeset status --since=main",
    "version-packages": "changeset version && node scripts/gen-whitelist.mjs",
    "release": "changeset publish",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && npm run publish:check",
    "ci": "node scripts/check-contrast.mjs && vitest run && node scripts/size-check.mjs && node scripts/check-whitelist-sync.mjs && node scripts/check-tokens-sync.mjs && node scripts/check-types-sync.mjs && node scripts/check-aria-sync.mjs",
    "demo": "vite",
    "demo:build": "vite build",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:gen": "node scripts/gen-docs.mjs",
    "register:e2e": "node scripts/check-register-e2e.mjs"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "mobile",
    "ui-library",
    "design-system",
    "tree-shaking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulor8908/af-mobile.git"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^1.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "jsdom": "^24.0.0",
    "lighthouse": "^12.2.1",
    "postcss": "^8.5.26",
    "vite": "^5.4.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.6.0",
    "web-vitals": "^4.2.4"
  }
}
