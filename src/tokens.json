{
  "$description": "AIFlow UI L1 设计 Token（W3C Design Tokens Format 1.1）。由 src/tokens.css 自动生成，勿手改，运行 `npm run tokens` 重新生成。palette 为 light 基准值，dark 值见 palette.$extensions.aiflow.theme.dark。阴影因源为 CSS 简写字符串，采用 string 类型保证 W3C 校验兼容。",
  "palette": {
    "brand": {
      "$type": "color",
      "$value": "#2B5CE6"
    },
    "brand-strong": {
      "$type": "color",
      "$value": "#1F46C8"
    },
    "onbrand": {
      "$type": "color",
      "$value": "#fff"
    },
    "brand-soft": {
      "$type": "color",
      "$value": "#EAF0FE"
    },
    "text": {
      "$type": "color",
      "$value": "#1B2434"
    },
    "muted": {
      "$type": "color",
      "$value": "#6B7893"
    },
    "card": {
      "$type": "color",
      "$value": "#fff"
    },
    "bg": {
      "$type": "color",
      "$value": "#F6F7F9"
    },
    "muted-bg": {
      "$type": "color",
      "$value": "#EEF1F6"
    },
    "border": {
      "$type": "color",
      "$value": "#E2E7F0"
    },
    "danger": {
      "$type": "color",
      "$value": "#E5484D"
    },
    "success": {
      "$type": "color",
      "$value": "#1A9E5A"
    },
    "warn": {
      "$type": "color",
      "$value": "#E58F18"
    },
    "shadow-sm": {
      "$type": "string",
      "$value": "0 1px 2px rgba(17,24,39,.05), 0 1px 3px rgba(17,24,39,.06)"
    },
    "shadow-md": {
      "$type": "string",
      "$value": "0 4px 8px rgba(17,24,39,.05), 0 8px 24px rgba(17,24,39,.07)"
    },
    "shadow-lg": {
      "$type": "string",
      "$value": "0 8px 16px rgba(17,24,39,.08), 0 24px 48px rgba(17,24,39,.12)"
    },
    "color-scheme": {
      "$type": "other",
      "$value": "light"
    },
    "$extensions": {
      "aiflow": {
        "theme": {
          "dark": {
            "brand": "#4F7BEF",
            "brand-strong": "#6B8FF0",
            "onbrand": "#fff",
            "brand-soft": "rgba(79,123,239,.16)",
            "text": "#E8ECF4",
            "muted": "#9AA6BD",
            "card": "#1C2333",
            "bg": "#10141E",
            "muted-bg": "#262E41",
            "border": "#2E3852",
            "danger": "#EF6A6E",
            "success": "#3BB574",
            "warn": "#F0A73C",
            "shadow-sm": "0 1px 2px rgba(0,0,0,.32), 0 1px 3px rgba(0,0,0,.36)",
            "shadow-md": "0 4px 8px rgba(0,0,0,.36), 0 8px 24px rgba(0,0,0,.42)",
            "shadow-lg": "0 8px 16px rgba(0,0,0,.42), 0 24px 48px rgba(0,0,0,.5)",
            "color-scheme": "dark"
          }
        }
      }
    }
  },
  "color": {
    "brand": {
      "$type": "color",
      "$value": "{palette.brand}"
    },
    "brand-strong": {
      "$type": "color",
      "$value": "{palette.brand-strong}"
    },
    "brand-soft": {
      "$type": "color",
      "$value": "{palette.brand-soft}"
    },
    "onbrand": {
      "$type": "color",
      "$value": "{palette.onbrand}"
    },
    "text": {
      "$type": "color",
      "$value": "{palette.text}"
    },
    "muted": {
      "$type": "color",
      "$value": "{palette.muted}"
    },
    "card": {
      "$type": "color",
      "$value": "{palette.card}"
    },
    "bg": {
      "$type": "color",
      "$value": "{palette.bg}"
    },
    "muted-bg": {
      "$type": "color",
      "$value": "{palette.muted-bg}"
    },
    "border": {
      "$type": "color",
      "$value": "{palette.border}"
    },
    "danger": {
      "$type": "color",
      "$value": "{palette.danger}"
    },
    "success": {
      "$type": "color",
      "$value": "{palette.success}"
    },
    "warn": {
      "$type": "color",
      "$value": "{palette.warn}"
    }
  },
  "spacing": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "40px"
    },
    "8": {
      "$type": "dimension",
      "$value": "56px"
    }
  },
  "typography": {
    "size": {
      "display": {
        "$type": "dimension",
        "$value": "28px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "20px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "17px"
      },
      "md": {
        "$type": "dimension",
        "$value": "15px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "13px"
      },
      "xs": {
        "$type": "dimension",
        "$value": "11px"
      }
    },
    "lineHeight": {
      "display": {
        "$type": "number",
        "$value": 1.15
      },
      "tight": {
        "$type": "number",
        "$value": 1.3
      },
      "normal": {
        "$type": "number",
        "$value": 1.55
      }
    },
    "weight": {
      "normal": {
        "$type": "number",
        "$value": 400
      },
      "medium": {
        "$type": "number",
        "$value": 500
      },
      "semibold": {
        "$type": "number",
        "$value": 600
      },
      "bold": {
        "$type": "number",
        "$value": 700
      }
    }
  },
  "radius": {
    "xs": {
      "$type": "dimension",
      "$value": "6px"
    },
    "s": {
      "$type": "dimension",
      "$value": "10px"
    },
    "m": {
