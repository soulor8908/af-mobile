    },
    "f": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "shadow": {
    "sm": {
      "$type": "string",
      "$value": "{palette.shadow-sm}"
    },
    "md": {
      "$type": "string",
      "$value": "{palette.shadow-md}"
    },
    "lg": {
      "$type": "string",
      "$value": "{palette.shadow-lg}"
    },
    "brand": {
      "$type": "string",
      "$value": "0 4px 14px rgba(43,92,230,.28)"
    }
  },
  "zIndex": {
    "base": {
      "$type": "number",
      "$value": 0
    },
    "sticky": {
      "$type": "number",
      "$value": 200
    },
    "dropdown": {
      "$type": "number",
      "$value": 1000
    },
    "modal": {
      "$type": "number",
      "$value": 1100
    }
  },
  "motion": {
    "out": {
      "$type": "cubicBezier",
      "$value": {
        "x1": 0.16,
        "y1": 1,
        "x2": 0.3,
        "y2": 1
      }
    },
    "in-out": {
      "$type": "cubicBezier",
      "$value": {
        "x1": 0.65,
        "y1": 0,
        "x2": 0.35,
        "y2": 1
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "250ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms"
      }
    }
  }
}
