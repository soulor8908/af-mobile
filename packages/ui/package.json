{
  "name": "@af-mobile/ui",
  "version": "1.3.2",
  "description": "Mobile-first Web Components library with L1/L2/L3 layered design system",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./css": "./src/index.css",
    "./aiflow-ui.css": "./src/index.css",
    "./tokens.css": "./src/tokens.css",
    "./tokens.json": "./src/tokens.json",
    "./recipes.css": "./src/recipes.css",
    "./atomic.css": "./src/atomic.css",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*",
    "./dist": "./dist/index.js",
    "./dist/css": "./dist/index.css",
    "./dist/umd": "./dist/aiflow-ui.umd.js"
  },
  "unpkg": "./dist/aiflow-ui.umd.js",
  "jsdelivr": "./dist/aiflow-ui.umd.js",
  "browser": "./dist/aiflow-ui.umd.js",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/build.mjs && node ../../scripts/publish-check.mjs"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "mobile",
    "ui-library",
    "design-system",
    "tree-shaking"
  ],
  "license": "MIT"
}
